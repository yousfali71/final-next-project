# ⚠️ For Production Deployment Only
# Copy this to .env.production and fill in your production values
# Never commit actual .env files to Git!

# Backend API URL (your deployed backend URL)
NEXT_PUBLIC_API_URL=https://your-backend-url.onrender.com/api

# Stripe Publishable Key (get from Stripe dashboard)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Google OAuth Client ID (get from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
